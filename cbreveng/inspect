#!/usr/bin/env python3
"""inspect: commands for examining a database in the ChessBase "2" format.

Run it without arguments (or with --help) to list the commands. Add a new
command by adding a function decorated with @cli.command().
"""
import os

import click

from morphy.columns import ID_COLUMN, available_columns, format_objects, parse_columns
from morphy.entities import GameTag, Player, Source, Team, Tournament
from morphy.entitydb import EntityDatabase
from morphy.gameheader import GameHeader
from morphy.gameheaderdb import GameHeaderDatabase
from morphy.moves import MoveDatabase
from morphy.nations import NATIONS


DEFAULT_EXTENSION = ".2cbh"


class DatabaseFile(click.ParamType):
    """A path to a database's game file. If no such file exists, the default
    extension is added, so "reveng1." and "reveng1" both find "reveng1.2cbh"
    (a trailing dot is what tab completion leaves you with)."""

    name = "file"

    def convert(self, value, param, ctx):
        if os.path.isfile(value):
            return value
        candidate = value + DEFAULT_EXTENSION[1:] if value.endswith(".") else value + DEFAULT_EXTENSION
        if os.path.isfile(candidate):
            return candidate
        self.fail(f"File {value!r} does not exist (also tried {candidate!r}).", param, ctx)


DATABASE_FILE = DatabaseFile()


def columns_option(cls):
    """A --columns option for choosing which columns of cls to show. The
    command gets the resulting list of column names, id first."""
    def parse(ctx, param, value):
        try:
            return parse_columns(cls, value)
        except ValueError as e:
            raise click.BadParameter(str(e))

    selectable = [name for name in available_columns(cls) if name != ID_COLUMN]
    return click.option(
        "--columns", callback=parse, metavar="COL1,COL2,...",
        help=f"Columns to show, separated by commas. The id column is always shown first. "
             f"Prefix a column with + to add it to the default columns, or with - to remove it "
             f"from them; if any column has no prefix, only the named columns are shown. "
             f"Default: {', '.join(cls.DEFAULT_COLUMNS)}. Available: {', '.join(selectable)}.",
    )


@click.group()
def cli():
    """Examine a ChessBase database."""


@cli.command()
@click.argument("file", type=DATABASE_FILE)
@click.option("--start", type=int, default=1, show_default=True, help="First game id to include.")
@click.option(
    "--limit", type=int, default=20, show_default=True,
    help="Maximum number of games to include; 0 means no limit.",
)
@columns_option(GameHeader)
def games(file, start, limit, columns):
    """Print a table of the games in a .2cbh file.

    Entity names and titles are resolved from the paired .2lid file, which has
    the same base name as FILE. The extension of FILE can be left out.
    """
    try:
        with EntityDatabase.for_game_file(file) as edb, GameHeaderDatabase(file, entities=edb) as gdb:
            last = gdb.count if limit <= 0 else min(start + limit - 1, gdb.count)
            table = format_objects((gdb.get(game_id) for game_id in range(start, last + 1)), columns)
    except (OSError, ValueError) as e:
        raise click.ClickException(str(e))

    click.echo(table)


@cli.command()
@click.argument("file", type=DATABASE_FILE)
@click.option("--start", type=int, default=1, show_default=True, help="First game id to include.")
@click.option(
    "--limit", type=int, default=20, show_default=True,
    help="Maximum number of games to include; 0 means no limit.",
)
@click.option("--raw", is_flag=True, help="Also print the record's framing and its words in hex.")
def moves(file, start, limit, raw):
    """Print the moves of the games in a database, with variations.

    The moves are read from the .2cbg file with the same base name as FILE,
    at the offsets in FILE. Moves are shown as the piece, the from and to
    squares and any capture or promotion, e.g. Ng1-f3, e4xd5, O-O. Guiding
    texts are only noted; the text command shows them. The extension of FILE
    can be left out.
    """
    try:
        with GameHeaderDatabase(file) as gdb, MoveDatabase.for_game_file(file) as mdb:
            last = gdb.count if limit <= 0 else min(start + limit - 1, gdb.count)
            for game_id in range(start, last + 1):
                offset = gdb.get(game_id).moves_offset
                try:
                    game = mdb.read(offset)
                except ValueError as e:
                    click.echo(f"#{game_id}: not decoded: {e}")
                    continue
                prefix = ""
                if game.chess960_position is not None:
                    prefix = f"[Chess960 #{game.chess960_position}] "
                elif game.setup_position:
                    prefix = f"[Setup: {game.setup_position}] "
                click.echo(f"#{game_id}: {prefix}{game.notation()}")
                if raw:
                    words = " ".join(f"{w:04x}" for w in game.words)
                    click.echo(
                        f"    offset {game.offset}, hash {game.hash.hex()}, {game.move_bytes} move bytes, "
                        f"{game.spare_bytes} spare, record length {game.record_length}\n    {words}"
                    )
    except (OSError, ValueError) as e:
        raise click.ClickException(str(e))


@cli.command()
@click.argument("file", type=DATABASE_FILE)
@click.argument("game_id", type=int)
@click.option("--html", is_flag=True, help="Print the HTML of each language, not just its size.")
def text(file, game_id, html):
    """Print the contents of a guiding text, one entry per language.

    GAME_ID is the text's id in FILE; its contents are read from the .2cbg
    file with the same base name. The extension of FILE can be left out.
    """
    try:
        with GameHeaderDatabase(file) as gdb, MoveDatabase.for_game_file(file) as mdb:
            guiding_text = mdb.read_text(gdb.get(game_id).moves_offset)
    except (OSError, ValueError, IndexError) as e:
        raise click.ClickException(str(e))

    for language, content in guiding_text.contents:
        name = NATIONS[language] if 0 < language < len(NATIONS) else "(none)" if language == 0 else f"?{language}"
        click.echo(f"{name}: {len(content)} bytes")
        if html:
            click.echo(content.decode("utf-8", errors="replace"))
            click.echo()


def entity_command(name, entities, cls, what):
    """Define a command listing one kind of entity, in id order. entities is
    the EntityDatabase method that yields them."""
    help_text = (
        f"Print a table of the {what} in a database, in id order.\n\n"
        f"{what.capitalize()} in the list of deleted entities are left out. They are read "
        f"from the .2lid file that has the same base name as FILE. The extension of FILE "
        f"can be left out."
    )

    @cli.command(name=name, help=help_text)
    @click.argument("file", type=DATABASE_FILE)
    @columns_option(cls)
    def command(file, columns):
        try:
            with EntityDatabase.for_game_file(file) as edb:
                table = format_objects(getattr(edb, entities)(), columns)
        except (OSError, ValueError) as e:
            raise click.ClickException(str(e))

        click.echo(table)

    return command


players = entity_command("players", "players", Player, "players")
tournaments = entity_command("tournaments", "tournaments", Tournament, "tournaments")
sources = entity_command("sources", "sources", Source, "sources")
teams = entity_command("teams", "teams", Team, "teams")
game_tags = entity_command("tags", "game_tags", GameTag, "game tags")


if __name__ == "__main__":
    cli()
