#!/usr/bin/env python3
"""games: print a table of games from a .2cbh file, with entity names and
titles resolved from the paired .2lid file (same base name)."""
import argparse

from morphy.entitydb import EntityDatabase
from morphy.gameheaderdb import GameHeaderDatabase
from morphy.util import format_table


def _player_name(edb, player_id):
    if player_id is None or player_id < 0:
        return ""
    try:
        player = edb.get_player(player_id)
    except IndexError:
        return f"?{player_id}"
    name = " ".join(part for part in (player.first_name, player.last_name) if part)
    return name or f"?{player_id}"


def _titled_name(getter, entity_id):
    if entity_id is None or entity_id < 0:
        return ""
    try:
        entity = getter(entity_id)
    except IndexError:
        return f"?{entity_id}"
    return entity.title or f"?{entity_id}"


# Each column is (header, function taking a GameHeader and an EntityDatabase).
# Add more columns here as more fields get decoded.
COLUMNS = [
    ("White", lambda game, edb: _player_name(edb, game.white_id)),
    ("Black", lambda game, edb: _player_name(edb, game.black_id)),
    ("Tournament", lambda game, edb: _titled_name(edb.get_tournament, game.tournament_id)),
    ("Annotator", lambda game, edb: _player_name(edb, game.annotator_id)),
    ("Source", lambda game, edb: _titled_name(edb.get_source, game.source_id)),
    ("White Team", lambda game, edb: _titled_name(edb.get_team, game.white_team_id)),
    ("Black Team", lambda game, edb: _titled_name(edb.get_team, game.black_team_id)),
    ("Tag", lambda game, edb: _titled_name(edb.get_game_tag, game.game_tag_id)),
]


def main():
    parser = argparse.ArgumentParser(prog="games", description="Print a table of games from a .2cbh file")
    parser.add_argument("file")
    parser.add_argument("--start", type=int, default=1, help="first game id to include (default: 1)")
    parser.add_argument(
        "--limit", type=int, default=20,
        help="maximum number of games to include (default: 20); 0 means no limit",
    )
    args = parser.parse_args()

    with GameHeaderDatabase(args.file) as gdb, EntityDatabase.for_game_file(args.file) as edb:
        last = gdb.count if args.limit <= 0 else min(args.start + args.limit - 1, gdb.count)

        headers = ["Game"] + [name for name, _ in COLUMNS]
        rows = []
        for game_id in range(args.start, last + 1):
            game = gdb.get(game_id)
            rows.append([game_id] + [getter(game, edb) for _, getter in COLUMNS])

    print(format_table(headers, rows))


if __name__ == "__main__":
    main()
